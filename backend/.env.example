# StockSense Backend Environment Variables

# Application
APP_ENV=development

# Database
# For SQLite (local development default): leave empty or use sqlite:///./stocksense.db
# For PostgreSQL: postgresql://user:password@localhost:5432/stocksense_db
DATABASE_URL=sqlite:///./stocksense.db

# Authentication / JWT
JWT_SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Third-Party APIs (Optional / Future Integration)
GROQ_API_KEY=
